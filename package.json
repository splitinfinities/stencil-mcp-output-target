{
  "name": "stencil-mcp-output-target",
  "version": "0.0.1",
  "description": "Stencil output target that ships a read-only MCP server inside your component library: list, search, read, validate, suggest and diagnose against the library's real API.",
  "keywords": [
    "stencil",
    "stenciljs",
    "output-target",
    "mcp",
    "model-context-protocol",
    "web-components",
    "design-system"
  ],
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema/index.v1.json": "./schema/index.v1.json",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "stencil-mcp-output-target": "dist/cli.js"
  },
  "files": [
    "dist/",
    "schema/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build.fixture": "pnpm build && pnpm --dir fixture build",
    "test": "node --test test/*.test.ts",
    "test.all": "pnpm build.fixture && pnpm test",
    "lint.licenses": "node scripts/check-licenses.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm lint.licenses && pnpm test.all"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stencil/core": "^4.45.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@stencil/core": "^4.45.2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "typescript": "5.9.3"
  }
}
